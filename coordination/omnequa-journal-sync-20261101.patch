+++ b/tools/omnequa_feed.py
@@ -4,6 +4,7 @@ Integration in tools/build.py: import omnequa_feed, then add
 The normal build and CI --check therefore cover the website feed, too.
 """
 import html, json, re, posixpath
+from pathlib import Path
 from urllib.parse import urljoin, urlsplit
 REPO='https://github.com/scottonchain/microcredit-vision'
 RAW='https://raw.githubusercontent.com/scottonchain/microcredit-vision/main/'
@@ -74,3 +75,32 @@ def render(posts):
         url=REPO+'/blob/main/posts/'+p['slug']+'.md'
         entries.append(dict(id=p.get('source_id',url),slug=p['slug'],title=p['title'],date=p['dt'].isoformat().replace('+00:00','Z'),author=p['author'],summary=p['summary'],tags=p['tag_list'],url=url,image=RAW+p['image'],content_html=markdown(p['body'])))
     return json.dumps(dict(version=1,updated=max(p['updated_dt'] for p in posts).isoformat().replace('+00:00','Z'),posts=entries),ensure_ascii=False,indent=2)+'\n'
+
+# One journal, two public homes. omnequa.org reads CANONICAL from this repository's main
+# branch on every page view and bundles EDITIONS as its saved copies, so all of them are
+# rendered from the same posts in the same build and checked together (CLAUDE.md,
+# "Operator-requested shared journal"; omnequa/README.md, "One journal, two public homes").
+CANONICAL='omnequa/feed.json'
+EDITIONS={
+    'omnequa/content/blog-feed.json':'the reviewed full-content snapshot the site build reads',
+    'omnequa/dist/journal-feed.json':'the bundled edition served at omnequa.org/journal-feed.json (compact JSON, as omnequa/tools/build.py writes it)',
+    'omnequa/content/blog-atom.xml':'the Atom metadata fallback the site build reads',
+    'omnequa/dist/feed.xml':'the Atom feed served at omnequa.org/feed.xml',
+}
+
+def editions(posts, atom):
+    """Every journal file the blog build keeps in step, keyed by repository path.
+    atom is the rendered feed.xml. Same posts in, identical bytes out, so the site
+    build (which copies content/ into dist/) and this build agree byte for byte."""
+    journal=render(posts)
+    return {CANONICAL:journal,'omnequa/content/blog-feed.json':journal,
+            'omnequa/dist/journal-feed.json':json.dumps(json.loads(journal),ensure_ascii=False),
+            'omnequa/content/blog-atom.xml':atom,'omnequa/dist/feed.xml':atom}
+
+def stale(files, root='.'):
+    """Journal paths whose file under root is missing or differs from the rendered set."""
+    out=[]
+    for path in (CANONICAL,*EDITIONS):
+        target=Path(root)/path
+        if not target.is_file() or target.read_text(encoding='utf-8')!=files[path]:out.append(path)
+    return out
