        "patch": "@@ -0,0 +1,23 @@\n+# ============================================================\n+# AgentBond \u2014 Environment Variables\n+# Copy to .env and fill with real values\n+# NEVER commit .env \u2014 only .env.example\n+# ============================================================\n+\n+# ---- Venice AI (required for agent risk assessment) ----\n+VENICE_API_KEY=your-venice-api-key-here\n+\n+# ---- Backend ----\n+PORT=3001\n+DATA_DIR=./data\n+\n+# ---- Next.js Frontend ----\n+NEXT_PUBLIC_API_URL=http://localhost:3001\n+NEXT_PUBLIC_ALCHEMY_API_KEY=your-alchemy-api-key-here\n+NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your-walletconnect-project-id\n+NEXT_PUBLIC_IGNORE_BUILD_ERROR=false\n+NEXT_PUBLIC_IPFS_BUILD=false\n+\n+# ---- Vercel (auto-set by Vercel deployment) ----\n+# VERCEL_PROJECT_PRODUCTION_URL=\n+# PORT="
