        "patch": "@@ -0,0 +1,41 @@\n+{\n+  \"name\": \"agentcash\",\n+  \"version\": \"0.1.3\",\n+  \"description\": \"Use AgentCash to access a directory of thousands of premium and free APIs.\",\n+  \"author\": {\n+    \"name\": \"AgentCash\",\n+    \"url\": \"https://app.agentcash.dev\"\n+  },\n+  \"homepage\": \"https://app.agentcash.dev\",\n+  \"repository\": \"https://github.com/Merit-Systems/agentcash-skills\",\n+  \"license\": \"Apache-2.0\",\n+  \"keywords\": [\"agentcash\", \"gateway\", \"payments\", \"tools\"],\n+  \"skills\": \"./skills/\",\n+  \"mcpServers\": \"./.mcp.json\",\n+  \"interface\": {\n+    \"displayName\": \"AgentCash\",\n+    \"shortDescription\": \"Discover and call APIs\",\n+    \"longDescription\": \"Discover free and premium APIs, inspect their request and response schemas, check your AgentCash balance, and call supported endpoints.\",\n+    \"developerName\": \"AgentCash\",\n+    \"category\": \"Productivity\",\n+    \"capabilities\": [\n+      \"Discover APIs\",\n+      \"Inspect API schemas\",\n+      \"Call APIs\",\n+      \"Check wallet balance\"\n+    ],\n+    \"websiteURL\": \"https://app.agentcash.dev\",\n+    \"supportURL\": \"https://github.com/Merit-Systems/agentcash-skills\",\n+    \"privacyPolicyURL\": \"https://merit.systems/privacy\",\n+    \"termsOfServiceURL\": \"https://merit.systems/terms\",\n+    \"defaultPrompt\": [\n+      \"Which APIs would be most useful to me?\",\n+      \"Show me my AgentCash balance.\",\n+      \"What enrichment APIs are available?\"\n+    ],\n+    \"brandColor\": \"#16A34A\",\n+    \"composerIcon\": \"./assets/icon.svg\",\n+    \"logo\": \"./assets/logo.svg\",\n+    \"logoDark\": \"./assets/logo-dark.svg\"\n+  }\n+}"
      },
