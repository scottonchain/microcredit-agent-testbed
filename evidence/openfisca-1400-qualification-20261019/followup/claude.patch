+
+
+def test_calc_beyond_last_threshold() -> None:
+    tax_base = numpy.array([1, 1.5, 2, 2.5, 4])
+    tax_scale = taxscales.LinearAverageRateTaxScale()
+    tax_scale.add_bracket(0, 0)
+    tax_scale.add_bracket(1, 0.1)
+    tax_scale.add_bracket(2, 0.2)
+
+    result = tax_scale.calc(tax_base)
+
+    tools.assert_near(
+        result,
+        [0.1, 0.225, 0.4, 0.5, 0.8],
+        absolute_error_margin=1e-9,
+    )
