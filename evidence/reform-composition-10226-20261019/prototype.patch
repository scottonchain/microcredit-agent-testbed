index 00000000000..278b8ceb83f
--- /dev/null
+++ b/policyengine_us/tests/test_tx_rebate_future_baseline.py
@@ -0,0 +1,56 @@
+"""Guard baseline extensions without changing production benefit lists.
+
+YAML cannot temporarily extend the baseline Python formula with a new input
+variable. This six-household test uses a test-only variable and scoped formula
+replacement. It tests baseline preservation, not arbitrary reform stacking.
+"""
+
+from pathlib import Path
+
+import pytest
+import yaml
+
+
+def test_tx_rebate_preserves_future_baseline_program(monkeypatch):
+    from policyengine_us import Simulation
+    from policyengine_us.model_api import Reform, SPMUnit, Variable, YEAR, add
+    from policyengine_us.reforms.states.tx.rebate.tx_rebate import tx_rebate
+    from policyengine_us.variables.household.income.spm_unit.spm_unit_benefits import (
+        spm_unit_benefits,
+    )
+
+    class claude_future_benefit(Variable):
+        value_type = float
+        label = "Test-only future baseline benefit"
+        entity = SPMUnit
+        definition_period = YEAR
+
+    original_formula = spm_unit_benefits.formula
+
+    def extended_baseline(spm_unit, period, parameters):
+        return original_formula(spm_unit, period, parameters) + add(
+            spm_unit, period, ["claude_future_benefit"]
+        )
+
+    # Simulate a future upstream baseline, not an earlier policy reform.
+    # Restore the imported class even if an assertion or model build fails.
+    monkeypatch.setattr(spm_unit_benefits, "formula", extended_baseline)
+
+    class future_baseline(Reform):
+        def apply(self):
+            # Country-system construction reapplies the reform set.
+            self.update_variable(claude_future_benefit)
+            self.update_variable(spm_unit_benefits)
+
+    # Exact six-state future-program case supplied by the non-author review.
+    # The fixture stays outside policy/ so the YAML runner does not execute it
+    # without this test-only baseline extension.
+    fixture = Path(__file__).parent / "fixtures/tx_rebate_future.yaml"
+    case = yaml.safe_load(fixture.read_text())[0]
+    inputs = case["input"]
+    simulation = Simulation(
+        situation=inputs, reform=(future_baseline, tx_rebate), default_input_period=2027
+    )
+    assert simulation.calculate("spm_unit_benefits", 2027) == pytest.approx(
+        case["output"]["spm_unit_benefits"]
+    )
