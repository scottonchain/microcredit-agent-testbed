    "send-ambiguous": { "forward": [], "private": ["applicant", "why"] },
    "poll-error": { "forward": [], "private": ["err"] },
    "replied": { "forward": [], "private": ["applicant", "reply", "tx", "backing", "cost", "model", "tokens"] },
